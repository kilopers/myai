# Корневой .env для docker-compose (скопируй в .env)

# php artisan key:generate — вставь сюда
APP_KEY=
APP_URL=http://localhost:8080
HTTP_PORT=8080

DB_DATABASE=screenshoter
DB_USERNAME=screenshoter
DB_PASSWORD=

# Первичный админ (сидится при старте, must_change_password=true)
ADMIN_EMAIL=admin@screenshoter.local
ADMIN_PASSWORD=admin

# GHCR-образы для автодеплоя (переопределение при необходимости)
# SERVER_IMAGE=ghcr.io/kilopers/screenshoter-server
# WEB_IMAGE=ghcr.io/kilopers/screenshoter-web
# IMAGE_TAG=latest
