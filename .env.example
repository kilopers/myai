# Корневой .env для docker-compose (скопируй в .env)

# php artisan key:generate — вставь сюда
APP_KEY=
APP_URL=http://localhost:8080
HTTP_PORT=8080

DB_DATABASE=myai
DB_USERNAME=myai
DB_PASSWORD=

# Первичный админ (сидится при старте, must_change_password=true)
ADMIN_EMAIL=admin@myai.local
ADMIN_PASSWORD=admin

# GHCR-образы для автодеплоя (переопределение при необходимости)
# SERVER_IMAGE=ghcr.io/kilopers/myai/server
# WEB_IMAGE=ghcr.io/kilopers/myai/web
# IMAGE_TAG=latest

# Watchtower (docker-compose.watchtower.yml): Bearer-токен HTTP API
# и порт. Тот же токен — в GitHub Secrets как WATCHTOWER_TOKEN.
WATCHTOWER_TOKEN=
WATCHTOWER_PORT=8283

# WebSockets (Laravel Reverb)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=myai
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_PUBLIC_HOST=myai.ai.kilop.ru
REVERB_PUBLIC_PORT=443
REVERB_PUBLIC_SCHEME=https
WS_PORT=8286

# Webhook автообновления десктопа: CI дёргает POST /api/desktop-release/sync
# после публикации GitHub Release. Тот же токен — в GitHub Secrets
# как RELEASE_SYNC_TOKEN (+ RELEASE_SYNC_URL = https://<домен>/api/desktop-release/sync).
# Сгенерировать: openssl rand -hex 32
RELEASE_SYNC_TOKEN=
