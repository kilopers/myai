# syntax=docker/dockerfile:1

# Базовый образ сервера: PHP-FPM + все системные зависимости и
# PHP-расширения проекта + бинарники фоновой конвертации файлов
# (ffmpeg/ffprobe, poppler pdfinfo/pdftoppm, LibreOffice soffice).
# Собирается редко и пушится в GHCR вручную (см. server/docker/README.md):
#   docker build -f server/Dockerfile.base \
#     -t ghcr.io/kilopers/myai/server-base:1.1 .
#   docker push ghcr.io/kilopers/myai/server-base:1.1
# server/Dockerfile собирается ПОВЕРХ этого образа (FROM .../server-base).
FROM php:8.5.12-fpm-alpine3.24

# Привязка GHCR-пакета к репозиторию — иначе GITHUB_TOKEN деплоя
# не сможет тянуть базовый образ при сборке server/Dockerfile.
LABEL org.opencontainers.image.source="https://github.com/kilopers/myai"

RUN apk add --no-cache \
        # зависимости PHP-расширений (dev-пакеты тянут runtime-библиотеки)
        freetype-dev \
        icu-dev \
        libavif-dev \
        libjpeg-turbo-dev \
        libpng-dev \
        libwebp-dev \
        libzip-dev \
        oniguruma-dev \
        # конвертация файлов: видео, растрирование pdf, Word→pdf
        ffmpeg \
        poppler-utils \
        libreoffice \
        ghostscript \
        fontconfig \
        ttf-dejavu \
    && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp --with-avif \
    # ВАЖНО: все расширения — ОДНИМ вызовом docker-php-ext-install.
    # Каждый вызов в конце удаляет /usr/src/php (маркер .docker-delete-me):
    # цикл по одному ext затирал сконфигурированный Makefile gd и
    # пересобирал его с дефолтными флагами — gd выходил без JPEG/WebP.
    # opcache НЕ ставим: в PHP 8.5 он встроен в ядро и не отключается —
    # попытка собрать его как shared-ext даёт пустой Makefile и
    # `cp: can't stat 'modules/*'` на этапе install.
    && docker-php-ext-install -j"$(nproc)" bcmath gd intl pcntl pdo_mysql zip \
    && rm -rf /var/cache/apk/*
